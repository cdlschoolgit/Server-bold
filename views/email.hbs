<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Email Verification - United CDL Training School</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #f4f6f9;
        color: #333333;
      }
      .email-container {
        max-width: 600px;
        margin: 30px auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }
      .header {
        background: #0f5a70;
        padding: 30px 20px;
        text-align: center;
        color: #ffffff;
      }
      .header h1 {
        margin: 0;
        font-size: 24px;
        letter-spacing: 0.5px;
      }
      .content {
        padding: 30px;
        text-align: center;
      }
      .greeting {
        font-size: 20px;
        font-weight: 600;
        color: #0f5a70;
        margin-bottom: 15px;
      }
      .message {
        font-size: 16px;
        line-height: 1.6;
        color: #4a5568;
        margin-bottom: 25px;
      }
      .btn {
        display: inline-block;
        padding: 14px 32px;
        font-size: 16px;
        font-weight: 600;
        color: #ffffff !important;
        background-color: #198754;
        text-decoration: none;
        border-radius: 8px;
        box-shadow: 0 4px 12px rgba(25, 135, 84, 0.3);
        margin: 10px 0 25px 0;
      }
      .footer {
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 20px;
        text-align: center;
        font-size: 13px;
        color: #718096;
      }
      .footer a {
        color: #0f5a70;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <div class="header">
        <h1>United CDL Training School</h1>
      </div>
      <div class="content">
        <div class="greeting">Hello, {{userName}}!</div>
        <p class="message">
          Thank you for registering for the <strong>United CDL Training School</strong> ELDT theory program.
          Please confirm that your email address is <strong>{{emailAddress}}</strong> to activate your student account.
        </p>
        <div>
          <a class="btn" href="{{verifyURL}}" target="_blank">
            Verify Email Address
          </a>
        </div>
        <p style="font-size: 13px; color: #a0aec0; margin-top: 20px;">
          If the button above does not work, copy and paste this link into your browser:<br />
          <a href="{{verifyURL}}" style="color: #0f5a70; word-break: break-all;">{{verifyURL}}</a>
        </p>
        <p style="font-size: 13px; color: #a0aec0; margin-top: 15px;">
          If you did not register for United CDL Training School, please disregard this email.
        </p>
      </div>
      <div class="footer">
        <p>&copy; United CDL Training School. All rights reserved.</p>
        <p>Support: <a href="mailto:support@unitedeldt.com">support@unitedeldt.com</a> | Phone: 301-888-6339</p>
      </div>
    </div>
  </body>
</html>
