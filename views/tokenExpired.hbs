<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Verification Status - United CDL Training School</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #f4f6f9;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .card {
        max-width: 500px;
        width: 90%;
        margin: 20px auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 40px 30px;
        text-align: center;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1);
      }
      .icon {
        font-size: 54px;
        margin-bottom: 20px;
      }
      h2 {
        color: #c53030;
        margin-top: 0;
        font-size: 24px;
      }
      p {
        color: #4a5568;
        font-size: 16px;
        line-height: 1.6;
        margin: 15px 0 25px 0;
      }
      .btn {
        display: inline-block;
        padding: 12px 28px;
        font-size: 16px;
        font-weight: 600;
        color: #ffffff;
        background-color: #0f5a70;
        text-decoration: none;
        border-radius: 8px;
        transition: background-color 0.2s ease;
      }
      .btn:hover {
        background-color: #0b4556;
      }
      .support {
        margin-top: 25px;
        font-size: 13px;
        color: #718096;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="icon">⚠️</div>
      <h2>Verification Token Expired</h2>
      <p>
        Your email verification link has expired or has already been used. If your account is already verified, you can sign in directly.
      </p>
      <a class="btn" href="https://www.unitedcdleldt.com/student/Login">
        Go to Student Login
      </a>
      <div class="support">
        Need assistance? Contact United CDL School support at <a href="mailto:support@unitedeldt.com" style="color: #0f5a70;">support@unitedeldt.com</a> or call 301-888-6339.
      </div>
    </div>
  </body>
</html>
